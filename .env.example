# 完美校园参数
SCHOOL_ID=你的学校编号
STUDENT_ID=你的学号
ROOM_VERIFY=你的房间验证编号

# 钉钉自定义机器人参数；未启用“加签”安全设置时，DINGTALK_SECRET 留空
DINGTALK_ACCESS_TOKEN=你的机器人_access_token
DINGTALK_SECRET=

# 每天 12:00（Asia/Shanghai）执行，并在容器启动时立即执行一次
SCHED_TZ=Asia/Shanghai
TZ=Asia/Shanghai
SCHEDULE_HOUR=12
SCHEDULE_MINUTE=0
RUN_ON_START=true
VERBOSE=false
